# --- functions/ (Hasura Action + event handler runtime) ---
HASURA_GRAPHQL_URL=https://<subdomain>.hasura.<region>.nhost.run/v1/graphql
HASURA_ADMIN_SECRET=<your nhost admin secret>
LLM_STUB_MODE=false            # set true if you have no LLM key — uses a disclosed stub with artificial delay
GROQ_API_KEY=<your groq free-tier key>   # https://console.groq.com — free tier

# --- frontend/ (Next.js, public — safe to expose) ---
NEXT_PUBLIC_NHOST_SUBDOMAIN=<your nhost subdomain>
NEXT_PUBLIC_NHOST_REGION=<your nhost region>
